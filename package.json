{
  "name": "pi-subagents",
  "version": "0.1.0",
  "description": "A pi extension that brings autonomous sub-agents to pi",
  "keywords": [
    "pi-package",
    "pi-extension",
    "subagent",
    "agent",
    "autonomous"
  ],
  "type": "module",
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "repository": {
    "type": "git",
    "url": "git+https://git.forest-arowana.ts.net/Bastian/pi-agent-subagents.git"
  },
  "author": "Bastian Stegmann",
  "license": "MIT",
  "bugs": {
    "url": "https://git.forest-arowana.ts.net/Bastian/pi-agent-subagents/issues"
  },
  "homepage": "https://git.forest-arowana.ts.net/Bastian/pi-agent-subagents",
  "scripts": {
    "fmt": "oxfmt src/ tests/ index.ts",
    "lint": "oxlint src/ tests/ index.ts",
    "check": "tsc --noEmit",
    "test": "node --test src/*.test.ts",
    "test:tui": "node --experimental-strip-types --test --test-concurrency=1 tests/tui/*.test.ts",
    "test:tui:repeat": "node tests/tui/repeat.mjs",
    "ci:fmt": "oxfmt --check src/ tests/ index.ts",
    "ci:lint": "pnpm run lint",
    "ci:check": "pnpm run check",
    "test:snapshots": "node --test src/worktree-snapshot.test.ts",
    "test:process": "node --test src/process-rpc.test.ts src/protection-adapter.test.ts tests/process/rpc-real.test.ts tests/process/host-real.test.ts tests/process/boundary-real.test.ts",
    "test:process:tui": "node --test --test-concurrency=1 tests/process/host-tui.test.ts",
    "test:process:protections": "node tests/process/protection-sources.ts && node --test --test-concurrency=1 tests/process/protections-real.test.ts tests/process/protections-tui-real.test.ts tests/process/protections-role-real.test.ts"
  },
  "peerDependencies": {
    "@mariozechner/pi-ai": ">=0.70.5",
    "@mariozechner/pi-coding-agent": ">=0.70.5",
    "@mariozechner/pi-tui": ">=0.70.5",
    "@sinclair/typebox": "*"
  },
  "peerDependenciesMeta": {
    "@mariozechner/pi-ai": {
      "optional": true
    },
    "@mariozechner/pi-coding-agent": {
      "optional": true
    },
    "@mariozechner/pi-tui": {
      "optional": true
    }
  },
  "devDependencies": {
    "@mariozechner/pi-ai": "0.73.0",
    "@mariozechner/pi-coding-agent": "0.73.0",
    "@mariozechner/pi-tui": "0.73.0",
    "@microsoft/tui-test": "0.1.0-beta.5",
    "@sinclair/typebox": "0.34.49",
    "@types/node": "^24",
    "oxfmt": "^0.33.0",
    "oxlint": "^1.0.0",
    "typescript": "^5"
  }
}
